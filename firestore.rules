rules_version = '2';

// 汎用のルール（機能を追加しても書き直さなくてよい形）
//
//   管理者    : すべて読み書きできる
//   参加者    : 自分が参加している旅行（プロファイル）のデータを読める
//               書けるのは uid 欄が自分になっているドキュメントだけ（「見ました」・位置など）
//   未登録の人: 何もできない
//
// データの置き場所
//   1つ目の旅行（七日島）     : ルート直下（/announcements, /teams, /members …）
//   2つ目以降の旅行           : /profiles/{pid}/announcements … のようにプロファイルの下
//   旅行の一覧                : /profiles/{pid}（root は1つ目の旅行を表す）
//   アカウントの一覧          : /accounts/{loginId}（旅行をまたいでアカウントを使い回すため）
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 管理者のメールアドレス。config.js の ADMIN_IDS + EMAIL_DOMAIN と一致させる
    function isAdmin() {
      return signedIn()
        && request.auth.token.email in ['admin1@island.example.com', 'admin2@island.example.com'];
    }

    function rootMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function profileMember(pid) {
      return signedIn() && exists(/databases/$(database)/documents/profiles/$(pid)/members/$(request.auth.uid));
    }

    // 書き込もうとしている（または消そうとしている）データの uid 欄が自分か
    function ownsNew() {
      return request.resource.data.get('uid', '') == request.auth.uid;
    }
    function ownsOld() {
      return resource.data.get('uid', '') == request.auth.uid;
    }

    // 旅行の一覧：ログインしていれば読める（どの旅行に入っているかを調べるため）
    match /profiles/{pid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 2つ目以降の旅行のデータ
    match /profiles/{pid}/{coll}/{docId} {
      allow read: if isAdmin() || profileMember(pid)
        || (coll == 'members' && signedIn() && docId == request.auth.uid);
      allow create, update: if isAdmin() || (profileMember(pid) && ownsNew());
      allow delete: if isAdmin() || (profileMember(pid) && ownsOld());
    }

    // 1つ目の旅行のデータ（ルート直下）
    match /{coll}/{docId} {
      allow read: if coll != 'profiles' && coll != 'accounts' && (isAdmin() || rootMember()
        || (coll == 'members' && signedIn() && docId == request.auth.uid));
      allow create, update: if coll != 'profiles' && coll != 'accounts' && (isAdmin() || (rootMember() && ownsNew()));
      allow delete: if coll != 'profiles' && coll != 'accounts' && (isAdmin() || (rootMember() && ownsOld()));
    }

    // アカウントの一覧（管理者だけ）
    match /accounts/{loginId} {
      allow read, write: if isAdmin();
    }
  }
}
